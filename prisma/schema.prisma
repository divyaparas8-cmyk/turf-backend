// ==============================================================================
//  SportMatrix & SportTurfs - Comprehensive Enterprise Prisma Database Schema
//  Database: MySQL (turf_db)
//  Covers:
//  - Public Website: Venues/Turfs, 4-Way Team Payment Engine (Dare, 50-50, Squad Split, Full Pay),
//    Corporate Booking Proposals, Find Booking, Reviews, 4-Tier Player Leaderboards
//  - Super Admin Dashboard: Owners Management, Multi-Tier Subscriptions, Role RBAC,
//    Global Advertising Suite, Payment Logs, Escrow Ledger, Dispute Resolution,
//    System Settings (Profile & Commission Rates), Global CRM & Audit Logs
//  - Admin / Turf Controller Panel: Real-time Operational Overview, Court Occupancy Tracking,
//    Branch-level CRM & WhatsApp Broadcasts, My Advertisements & 4-Step Campaign Creator,
//    Full 4-Step Discount Offers Engine (Coupons, Off-peak Deals, Geo-Targeting, Limits),
//    Commission Management & Settlement Invoices
//  - Facility Operations: Multi-Branch, Sports, Dynamic Slots, 5-min Hold Engine,
//    Tournaments, Wallets, POS Billing, Inventory, Holidays
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// 1. ENUMS
// ------------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  OWNER
  STAFF
  UMPIRE
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SportStatus {
  ACTIVE
  INACTIVE
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
  COMPLETED
}

enum MatchPaymentMode {
  FULL_PAY      // "Tera Bhai Dega!" - 100% upfront by single captain
  SPLIT_50_50   // "Aadha Bill Tera, Aadha Mera!" - 50% paid by each captain
  PER_PLAYER    // "Apna Hissa, Khud Bharo!" - individual share per player UPI
  DARE_TO_PLAY  // "Dum Hai Toh Harake Dikha!" - Winner plays 100% FREE, Loser pays all
}

enum MatchStatus {
  SLOT_HELD
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  HELD
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum PaymentMethod {
  UPI
  CASH
  CARD
  WALLET
  BANK_TRANSFER
  ONLINE
}

enum CorporateStatus {
  NEW
  CONTACTED
  PROPOSAL_SENT
  NEGOTIATING
  CONFIRMED
  REJECTED
  COMPLETED
}

enum CorporatePaymentTerm {
  GST_INVOICE_30_DAY_NET
  SPLIT_50_ADVANCE_50_POST
  CORPORATE_CARD
  UPI_COMPANY_RAZORPAY
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum AdType {
  GUARANTEED_BOOKING // Commission-based model guaranteeing minimum court bookings
  DISCOUNT_OFFER     // Discount coupon promotional push
  IMPRESSION_AD      // High-visibility CPM banners & video ad
}

enum AdStatus {
  DRAFT
  PENDING
  APPROVED
  ACTIVE
  PAUSED
  BOOKING_GENERATED
  COMMISSION_PENDING
  PAID
  COMPLETED
  EXPIRED
  REJECTED
}

enum AdCommissionStatus {
  PENDING
  PAID
  SETTLED
}

enum DiscountType {
  PERCENTAGE   // e.g. 25% OFF
  FLAT_AMOUNT  // e.g. Flat ₹300 OFF
}

enum DiscountStatus {
  DRAFT
  ACTIVE
  SCHEDULED
  EXPIRED
  CANCELLED
}

enum LeadCategory {
  CAPTAIN_TEAM  // Captains & Teams
  PLAYER        // Free Agent / Regular Players
  UMPIRE        // Certified Umpires / Referees
  ORGANIZER     // Tournament Organizers
  CORPORATE     // Corporate HR / Team Leads
}

enum LeadStatus {
  NEW
  HOT_LEAD
  CONTACTED
  CORPORATE_PROPOSAL
  ACTIVE
  INACTIVE
}

enum DisputeType {
  ESCROW        // Escrow funds dispute (player no-show, match not conducted)
  REFUND        // Refund requested (venue cancelled, weather cancellation)
  MATCH_RESULT  // Score/Winner dispute between rival teams
  DAMAGE        // Facility or equipment damage claim
  CANCELLATION  // Late cancellation dispute
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum LeaderboardTier {
  SELF_ENTRY           // Tier 0: Self-reported score (0.0x weight)
  CAPTAIN_HANDSHAKE    // Tier 1: Opponent captain signed off (1.0x weight)
  PAID_UMPIRE          // Tier 2: Official platform referee signed off (1.5x weight)
  OFFICIAL_TOURNAMENT  // Tier 3: Verified competitive tournament match (2.0x weight)
}

enum TournamentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REGISTRATION_OPEN
  FEW_SLOTS_LEFT
  UPCOMING
  ACTIVE
  RUNNING
  COMPLETED
  CANCELLED
  REJECTED
}

enum TournamentTeamStatus {
  PENDING
  CONFIRMED
  APPROVED
  REJECTED
  CANCELLED
}

enum FixtureStatus {
  SCHEDULED
  LIVE
  COMPLETED
  ABANDONED
}

enum WalletTxType {
  BOOKING
  TOURNAMENT
  REFUND
  TOP_UP
  PRIZE
  ESCROW_HOLD
  ESCROW_RELEASE
  COMMISSION
  WITHDRAWAL
}

// ------------------------------------------------------------------------------
// 2. AUTHENTICATION, USERS & SUPER ADMIN PROFILE
// ------------------------------------------------------------------------------

model User {
  id               String       @id @default(cuid()) @map("id") @db.VarChar(50)
  name             String       @map("name") @db.VarChar(100)
  email            String       @unique @map("email") @db.VarChar(100)
  passwordHash     String       @map("password_hash") @db.VarChar(255)
  role             Role         @default(CUSTOMER) @map("role")
  mobile           String?      @map("mobile") @db.VarChar(20)
  alternateMobile  String?      @map("alternate_mobile") @db.VarChar(20)
  avatar           String?      @map("avatar") @db.VarChar(255)
  status           UserStatus   @default(ACTIVE) @map("status")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at")

  // Relationships
  ownerProfile     Owner?
  umpireProfile    UmpireProfile?
  playerProfile    PlayerProfile?
  staffMemberProfile StaffMember?
  managedBranches  Branch[]     @relation("OwnerBranches")
  staffBranchId    String?      @map("staff_branch_id") @db.VarChar(50)
  staffBranch      Branch?      @relation("StaffBranch", fields: [staffBranchId], references: [id], onDelete: SetNull)
  bookings         Booking[]
  matchesAsCaptainA Match[]     @relation("CaptainAMatches")
  matchesAsCaptainB Match[]     @relation("CaptainBMatches")
  matchPayments    MatchPayment[]
  teamJoinRequests TeamMembershipRequest[]
  scoreSubmissions PlayerScoreSubmission[]
  wallet           Wallet?
  payments         Payment[]
  disputesRaised   Dispute[]    @relation("UserDisputes")
  disputesResolved Dispute[]    @relation("ResolvedByAdmin")
  reviews          Review[]
  umpireScoredMatches Scorecard[] @relation("UmpireVerifications")
  activityLogs     ActivityLog[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model Owner {
  id              String       @id @default(cuid()) @map("id") @db.VarChar(50)
  userId          String       @unique @map("user_id") @db.VarChar(50)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Personal & Contact Info
  fullName        String       @map("full_name") @db.VarChar(100)
  email           String       @unique @map("email") @db.VarChar(100)
  mobile          String       @map("mobile") @db.VarChar(20)
  alternateMobile String?      @map("alternate_mobile") @db.VarChar(20)
  profileImage    String?      @map("profile_image") @db.LongText
  status          UserStatus   @default(ACTIVE) @map("status")

  // Business Details
  businessName    String       @map("business_name") @db.VarChar(150)
  businessType    String?      @default("Sports & Recreation") @map("business_type") @db.VarChar(100)
  gstNumber       String?      @map("gst_number") @db.VarChar(50)
  panNumber       String?      @map("pan_number") @db.VarChar(50)

  // Address
  country         String?      @default("India") @map("country") @db.VarChar(100)
  state           String?      @map("state") @db.VarChar(100)
  city            String?      @map("city") @db.VarChar(100)
  zipCode         String?      @map("zip_code") @db.VarChar(20)
  fullAddress     String?      @map("full_address") @db.Text

  // Financial & Subscription Status
  activePlanId    String?      @map("active_plan_id") @db.VarChar(50)
  subscriptionPlan SubscriptionPlan? @relation(fields: [activePlanId], references: [id], onDelete: SetNull)
  totalCommissionEarned Decimal @default(0.00) @map("total_commission_earned") @db.Decimal(12, 2)
  totalRevenueGenerated Decimal @default(0.00) @map("total_revenue_generated") @db.Decimal(12, 2)

  createdBy       String?      @map("created_by") @db.VarChar(50)
  updatedBy       String?      @map("updated_by") @db.VarChar(50)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at")

  // Relationships
  branches        Branch[]
  subscriptions   OwnerSubscription[]
  advertisements  Advertisement[]
  adCommissions   AdCommission[]
  adPayments      AdPayment[]
  discountOffers  DiscountOffer[]

  @@map("owners")
}

// ------------------------------------------------------------------------------
// 3. SUBSCRIPTIONS & PRICING PLANS
// ------------------------------------------------------------------------------

model SubscriptionPlan {
  id                       String             @id @map("id") @db.VarChar(50) // e.g. plan_starter, plan_pro, plan_enterprise
  planName                 String             @map("plan_name") @db.VarChar(100)
  description              String?            @map("description") @db.Text
  isPopular                Boolean            @default(false) @map("is_popular")
  status                   SubscriptionStatus @default(ACTIVE) @map("status")

  // Monthly Pricing & Limits
  monthlyPrice             Decimal            @default(0.00) @map("monthly_price") @db.Decimal(10, 2)
  monthlyBranchLimit       Int                @default(1) @map("monthly_branch_limit") // -1 for unlimited
  monthlySportsLimit       Int                @default(2) @map("monthly_sports_limit")
  monthlyBookingLimit      Int                @default(200) @map("monthly_booking_limit")
  monthlyActiveUsersLimit  Int                @default(5) @map("monthly_active_users_limit")

  // Yearly Pricing & Limits (with 20% discount default)
  yearlyPrice              Decimal            @default(0.00) @map("yearly_price") @db.Decimal(10, 2)
  yearlyBranchLimit        Int                @default(1) @map("yearly_branch_limit")
  yearlySportsLimit        Int                @default(2) @map("yearly_sports_limit")
  yearlyBookingLimit       Int                @default(2500) @map("yearly_booking_limit")
  yearlyActiveUsersLimit   Int                @default(5) @map("yearly_active_users_limit")

  // Features list as JSON array (e.g. ["Online Slot Booking", "POS Integration", ...])
  features                 Json               @map("features")
  bonusPerks               Json?              @map("bonus_perks")

  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @default(now()) @updatedAt @map("updated_at")

  // Relationships
  branches                 Branch[]
  owners                   Owner[]
  ownerSubscriptions       OwnerSubscription[]

  @@map("subscription_plans")
}

model OwnerSubscription {
  id            String             @id @default(cuid()) @map("id") @db.VarChar(50)
  ownerId       String?            @map("owner_id") @db.VarChar(50)
  owner         Owner?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  planId        String?            @map("plan_id") @db.VarChar(50)
  plan          SubscriptionPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)

  planName      String?            @default("Starter Plan") @map("plan_name") @db.VarChar(100)
  amount        Decimal            @default(0.00) @map("amount") @db.Decimal(10, 2)
  billingCycle  BillingCycle       @default(MONTHLY) @map("billing_cycle")
  status        SubscriptionStatus @default(ACTIVE) @map("status")
  paymentStatus PaymentStatus      @default(COMPLETED) @map("payment_status")
  paymentMethod String?            @default("ONLINE") @map("payment_method") @db.VarChar(50)
  transactionId String?            @map("transaction_id") @db.VarChar(100)
  lastPaymentId String?            @map("last_payment_id") @db.VarChar(50)

  startDate     DateTime           @default(now()) @map("start_date")
  endDate       DateTime?          @map("end_date")
  autoRenew     Boolean            @default(true) @map("auto_renew")

  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at")

  @@index([ownerId])
  @@index([status])
  @@map("owner_subscriptions")
}

// ------------------------------------------------------------------------------
// 4. BRANCHES, VENUES & SPORTS FACILITIES
// ------------------------------------------------------------------------------

model Branch {
  id                 String             @id @map("id") @db.VarChar(50) // e.g. br_001
  branchName         String             @map("branch_name") @db.VarChar(150)
  branchCode         String             @unique @map("branch_code") @db.VarChar(50) // e.g. GA-MUM-01
  description        String?            @map("description") @db.Text
  ownerId            String?            @map("owner_id") @db.VarChar(50)
  owner              Owner?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerUserId        String?            @map("owner_user_id") @db.VarChar(50)
  ownerUser          User?              @relation("OwnerBranches", fields: [ownerUserId], references: [id], onDelete: SetNull)
  subscriptionPlanId String?            @default("plan_starter") @map("subscription_plan_id") @db.VarChar(50)
  subscriptionPlan   SubscriptionPlan?  @relation(fields: [subscriptionPlanId], references: [id], onDelete: SetNull)
  subscriptionPriceSnapshot Decimal?    @map("subscription_price_snapshot") @db.Decimal(10, 2)
  planPrice          Decimal            @default(0.00) @map("plan_price") @db.Decimal(10, 2)

  // Location Details
  country            String?            @default("India") @map("country") @db.VarChar(100)
  state              String?            @map("state") @db.VarChar(100)
  city               String?            @map("city") @db.VarChar(100)
  area               String?            @map("area") @db.VarChar(100) // e.g. Palasia, Vijay Nagar, Andheri West
  zipCode            String?            @map("zip_code") @db.VarChar(20)
  fullAddress        String?            @map("full_address") @db.Text
  latitude           Decimal?           @map("latitude") @db.Decimal(10, 8)
  longitude          Decimal?           @map("longitude") @db.Decimal(11, 8)

  // Contact Info
  email              String?            @map("email") @db.VarChar(100)
  mobile             String?            @map("mobile") @db.VarChar(20)
  alternateMobile    String?            @map("alternate_mobile") @db.VarChar(20)
  gstNumber          String?            @map("gst_number") @db.VarChar(50)
  timezone           String?            @default("Asia/Kolkata") @map("timezone") @db.VarChar(50)
  currency           String?            @default("INR") @map("currency") @db.VarChar(10)

  // Facility Showcase Attributes
  logo               String?            @map("logo") @db.LongText
  images             Json?              @map("images") // Array of venue photo URLs
  surfaceType        String?            @default("TurfPro Synthetic Arena") @map("surface_type") @db.VarChar(100)
  dimensionsSqFt     Int?               @default(5000) @map("dimensions_sqft")
  rating             Decimal            @default(4.50) @map("rating") @db.Decimal(3, 2)
  reviewCount        Int                @default(120) @map("review_count")
  minPriceHourly     Decimal            @default(700.00) @map("min_price_hourly") @db.Decimal(10, 2)
  openingTime        String             @default("06:00:00") @map("opening_time") @db.VarChar(20)
  closingTime        String             @default("23:00:00") @map("closing_time") @db.VarChar(20)
  amenities          Json?              @map("amenities") // e.g. ["Floodlights", "Changing Rooms", "Parking", "Cafeteria"]
  status             BranchStatus       @default(ACTIVE) @map("status")

  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at")

  // Relationships
  staffMembers       User[]             @relation("StaffBranch")
  branchStaff        StaffMember[]
  branchMedia        BranchMedia[]
  branchSports       BranchSport[]
  slots              Slot[]
  slotHolds          SlotHold[]
  tournaments        Tournament[]
  clubTeams          ClubTeam[]
  holidays           Holiday[]
  inventory          Inventory[]
  posOrders          PosOrder[]
  equipmentRentals   EquipmentRental[]
  refundRequests     RefundRequest[]
  maintenanceTasks   MaintenanceTask[]
  umpireDuties       UmpireDutyAssignment[]
  advertisements     Advertisement[]
  adCommissions      AdCommission[]
  adPayments         AdPayment[]
  discountOffers     DiscountOffer[]
  crmLeads           CrmLead[]
  corporateBookings  CorporateBooking[]
  reviews            Review[]
  matches            Match[]
  dareChallenges     DareChallenge[]
  payoutAccount      OwnerPayoutAccount?

  @@index([city])
  @@index([status])
  @@map("branches")
}


enum MediaType {
  PHOTO
  VIDEO
}

model BranchMedia {
  id          String    @id @default(cuid()) @map("id") @db.VarChar(50)
  branchId    String    @map("branch_id") @db.VarChar(50)
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  title       String    @map("title") @db.VarChar(150) // e.g. "Main Arena Floodlight View", "Full Arena Night Drone View"
  mediaType   MediaType @default(PHOTO) @map("media_type") // PHOTO or VIDEO
  mediaUrl    String    @map("media_url") @db.VarChar(255)
  isMainCover Boolean   @default(false) @map("is_main_cover")
  description String?   @map("description") @db.Text

  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([branchId])
  @@map("branch_media")
}

model Sport {
  id                  String        @id @map("id") @db.VarChar(50) // e.g. sp_master_01
  name                String        @unique @map("name") @db.VarChar(50) // Football, Cricket, Badminton, etc.
  icon                String?       @default("⚽") @map("icon") @db.VarChar(10)
  category            String?       @default("Team Sport") @map("category") @db.VarChar(50)
  defaultSlotDuration Int           @default(60) @map("default_slot_duration")

  branchSports        BranchSport[]
  slots               Slot[]
  tournaments         Tournament[]
  matches             Match[]
  dareChallenges      DareChallenge[]

  @@map("sports")
}


model BranchSport {
  id                 String      @id @map("id") @db.VarChar(50) // e.g. bs_001
  branchId           String      @map("branch_id") @db.VarChar(50)
  branch             Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sportId            String      @map("sport_id") @db.VarChar(50)
  sport              Sport       @relation(fields: [sportId], references: [id], onDelete: Cascade)

  regularPrice       Decimal     @default(1000.00) @map("regular_price") @db.Decimal(10, 2) // e.g. ₹1000/hr (06:00-17:00)
  peakPrice          Decimal     @default(1500.00) @map("peak_price") @db.Decimal(10, 2)    // e.g. ₹1500/hr (18:00-23:00)
  split5050Price     Decimal     @default(500.00) @map("split_50_50_price") @db.Decimal(10, 2)
  totalCourts        Int         @default(2) @map("total_courts") // e.g. 2 Active Courts/Turfs
  openingTime        String      @default("06:00:00") @map("opening_time") @db.VarChar(20)
  closingTime        String      @default("23:00:00") @map("closing_time") @db.VarChar(20)
  slotDuration       Int         @default(60) @map("slot_duration")
  
  // Umpire & Live Scorer Addon Service
  umpireAddonActive  Boolean     @default(true) @map("umpire_addon_active")
  umpireAddonPrice   Decimal     @default(300.00) @map("umpire_addon_price") @db.Decimal(10, 2) // +₹300 during booking

  status             SportStatus @default(ACTIVE) @map("status")

  @@unique([branchId, sportId])
  @@map("branch_sports")
}

// ------------------------------------------------------------------------------
// 5. SCHEDULING, SLOTS & COURT UTILIZATION TRACKING
// ------------------------------------------------------------------------------

model Slot {
  id           String     @id @map("id") @db.VarChar(50) // e.g. slot_1785521511225_782
  branchId     String     @map("branch_id") @db.VarChar(50)
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sportId      String?    @map("sport_id") @db.VarChar(50)
  sport        Sport?     @relation(fields: [sportId], references: [id], onDelete: Cascade)

  courtName    String     @map("court_name") @db.VarChar(100)
  slotDate     DateTime   @map("slot_date") @db.Date
  startTime    String     @map("start_time") @db.VarChar(20) // e.g. "18:00:00"
  endTime      String     @map("end_time") @db.VarChar(20)   // e.g. "19:00:00"
  duration     Int        @map("duration") // In minutes (e.g. 60, 120)
  regularPrice Decimal    @default(0.00) @map("regular_price") @db.Decimal(10, 2)
  peakPrice    Decimal    @default(0.00) @map("peak_price") @db.Decimal(10, 2)
  isPeakHour   Boolean    @default(false) @map("is_peak_hour")
  status       SlotStatus @default(AVAILABLE) @map("status")
  notes        String?    @map("notes") @db.Text

  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at")

  // Relationships
  bookings     Booking[]
  slotHolds    SlotHold[]
  matches      Match[]
  dareChallenges DareChallenge[]

  @@unique([branchId, courtName, slotDate, startTime])
  @@index([branchId, slotDate])
  @@index([status])
  @@map("slots")
}

// ------------------------------------------------------------------------------
// 5B. DARE CHALLENGES & OPEN MATCH CALLOUTS
// ------------------------------------------------------------------------------

model DareChallenge {
  id              String         @id @default(cuid()) @map("id") @db.VarChar(50)
  branchId        String         @map("branch_id") @db.VarChar(50)
  branch          Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sportId         String?        @map("sport_id") @db.VarChar(50)
  sport           Sport?         @relation(fields: [sportId], references: [id], onDelete: SetNull)
  slotId          String?        @map("slot_id") @db.VarChar(50)
  slot            Slot?          @relation(fields: [slotId], references: [id], onDelete: SetNull)

  challengerTeam  String         @map("challenger_team") @db.VarChar(100) // e.g. "Palasia Smashers"
  captainName     String?        @map("captain_name") @db.VarChar(100)
  captainMobile   String?        @map("captain_mobile") @db.VarChar(20)

  matchDate       DateTime?      @map("match_date") @db.Date
  matchTime       String         @map("match_time") @db.VarChar(100) // e.g. "Tomorrow, 7:00 AM – 8:00 AM"
  matchFee        Decimal        @default(1800.00) @map("match_fee") @db.Decimal(10, 2)
  depositFee      Decimal        @default(540.00) @map("deposit_fee") @db.Decimal(10, 2) // 30% security deposit
  sportName       String         @default("Box Cricket") @map("sport_name") @db.VarChar(50)
  badge           String         @default("🔥 LIVE DARE") @map("badge") @db.VarChar(50)
  status          String         @default("ACTIVE") @map("status") @db.VarChar(20) // ACTIVE, ACCEPTED, COMPLETED, CANCELLED

  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at")

  @@index([branchId])
  @@index([status])
  @@map("dare_challenges")
}


model SlotHold {
  id              String   @id @default(cuid()) @map("id") @db.VarChar(50)
  slotId          String?  @map("slot_id") @db.VarChar(50)
  slot            Slot?    @relation(fields: [slotId], references: [id], onDelete: Cascade)
  branchId        String?  @map("branch_id") @db.VarChar(50)
  branch          Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  matchId         String?  @map("match_id") @db.VarChar(50)
  match           Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)

  slotDate        DateTime @map("slot_date") @db.Date
  startTime       String   @map("start_time") @db.VarChar(20)
  endTime         String   @map("end_time") @db.VarChar(20)
  heldByUserId    String?  @map("held_by_user_id") @db.VarChar(50)
  durationMinutes Int      @default(5) @map("duration_minutes")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([slotId])
  @@index([slotId, expiresAt])
  @@map("slot_holds")
}

// ------------------------------------------------------------------------------
// 6. MATCH BOOKINGS, SQUAD SPLIT PAY & DARE MODE ENGINE
// ------------------------------------------------------------------------------

model Match {
  id                       String           @id @map("id") @db.VarChar(50) // e.g. MATCH-178700-482
  slotId                   String?          @map("slot_id") @db.VarChar(50)
  slot                     Slot?            @relation(fields: [slotId], references: [id], onDelete: SetNull)
  branchId                 String?          @map("branch_id") @db.VarChar(50)
  branch                   Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sportId                  String?          @map("sport_id") @db.VarChar(50)
  sport                    Sport?           @relation(fields: [sportId], references: [id], onDelete: SetNull)

  // Team & Captain Details
  captainAId               String?          @map("captain_a_id") @db.VarChar(50)
  captainA                 User?            @relation("CaptainAMatches", fields: [captainAId], references: [id], onDelete: SetNull)
  captainBId               String?          @map("captain_b_id") @db.VarChar(50)
  captainB                 User?            @relation("CaptainBMatches", fields: [captainBId], references: [id], onDelete: SetNull)
  teamAName                String           @default("Team A Strikers") @map("team_a_name") @db.VarChar(100)
  teamBName                String           @default("Open Challenge") @map("team_b_name") @db.VarChar(100)

  // Payment Strategy
  paymentMode              MatchPaymentMode @default(FULL_PAY) @map("payment_mode")
  matchStatus              MatchStatus      @default(SLOT_HELD) @map("match_status")
  totalAmount              Decimal          @map("total_amount") @db.Decimal(10, 2)
  teamAShare               Decimal          @default(0.00) @map("team_a_share") @db.Decimal(10, 2)
  teamBShare               Decimal          @default(0.00) @map("team_b_share") @db.Decimal(10, 2)
  perPlayerAmount          Decimal          @default(0.00) @map("per_player_amount") @db.Decimal(10, 2)
  opponentPaymentDeadline  DateTime?        @map("opponent_payment_deadline")
  dareStrategy             String?          @default("SECURED_PREPAYMENT") @map("dare_strategy") @db.VarChar(50)

  // Financial & Legal Snapshots
  financialSnapshot        Json?            @map("financial_snapshot")
  commissionRateSnapshot   Decimal?         @map("commission_rate_snapshot") @db.Decimal(5, 2)
  planIdSnapshot           String?          @map("plan_id_snapshot") @db.VarChar(50)
  cancellationPolicySnapshot Json?          @map("cancellation_policy_snapshot")

  // Match Scoring & Captain Handshake
  hasUmpireAssigned        Boolean          @default(false) @map("has_umpire_assigned")
  umpireAddonFee           Decimal          @default(0.00) @map("umpire_addon_fee") @db.Decimal(10, 2)
  teamAScore               Int?             @map("team_a_score")
  teamBScore               Int?             @map("team_b_score")
  winnerTeamSide           String?          @map("winner_team_side") @db.VarChar(20) // "TEAM_A" or "TEAM_B"

  // Opponent Invite Token (Team B payment link)
  inviteTokenHash          String?          @unique @map("invite_token_hash") @db.VarChar(64)
  inviteExpiresAt          DateTime?        @map("invite_expires_at")
  inviteStatus             String?          @map("invite_status") @db.VarChar(20) // SENT, PAID, DECLINED

  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @default(now()) @updatedAt @map("updated_at")

  // Relationships
  slotHolds                SlotHold[]
  matchTeams               MatchTeam[]
  matchPayments            MatchPayment[]
  matchHandshake           MatchHandshake?
  umpireDuty               UmpireDutyAssignment?
  liveSessions             LiveMatchSession[]
  disputes                 Dispute[]

  @@index([branchId, matchStatus])
  @@map("matches")
}

model MatchTeam {
  id               String       @id @map("id") @db.VarChar(50) // e.g. TEAM-A-MATCH-101
  matchId          String       @map("match_id") @db.VarChar(50)
  match            Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamSide         String       @map("team_side") @db.VarChar(10) // "TEAM_A" or "TEAM_B"
  teamName         String       @map("team_name") @db.VarChar(100)
  captainName      String?      @map("captain_name") @db.VarChar(100)
  captainPhone     String?      @map("captain_phone") @db.VarChar(20)
  paidPlayerCount  Int          @default(0) @map("paid_player_count")
  createdAt        DateTime     @default(now()) @map("created_at")

  @@map("match_teams")
}

model MatchPayment {
  id               String        @id @default(cuid()) @map("id") @db.VarChar(50)
  matchId          String        @map("match_id") @db.VarChar(50)
  match            Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId           String?       @map("user_id") @db.VarChar(50)
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  teamSide         String?       @default("TEAM_A") @map("team_side") @db.VarChar(10) // "TEAM_A" or "TEAM_B"
  playerName       String?       @default("Player") @map("player_name") @db.VarChar(100)
  playerPhone      String?       @default("") @map("player_phone") @db.VarChar(20)
  amount           Decimal       @map("amount") @db.Decimal(10, 2)
  paymentMode      String?       @default("FULL_PAY") @map("payment_mode") @db.VarChar(50) // FULL_PAY, DARE_DEPOSIT, 50_50_SHARE, SQUAD_SPLIT
  paymentStatus    PaymentStatus @default(PENDING) @map("payment_status")
  gatewayRef       String?       @map("gateway_ref") @db.VarChar(100)
  upiTransactionId String?       @map("upi_transaction_id") @db.VarChar(100)
  idempotencyKey   String?       @unique @map("idempotency_key") @db.VarChar(100)

  // Commission-split settlement (Phase 1 payment gateway abstraction). paymentStatus
  // only flips to COMPLETED once both legs below are CONFIRMED by the active
  // PaymentGatewayProvider (manual confirmation today, automatic once a real
  // gateway such as Razorpay Route is plugged into PaymentGatewayConfig).
  commissionAmount     Decimal              @default(0.00) @map("commission_amount") @db.Decimal(10, 2)
  ownerAmount          Decimal              @default(0.00) @map("owner_amount") @db.Decimal(10, 2)
  ownerPayoutStatus    SettlementLegStatus  @default(PENDING) @map("owner_payout_status")
  commissionStatus     SettlementLegStatus  @default(PENDING) @map("commission_status")
  ownerConfirmedAt     DateTime?            @map("owner_confirmed_at")
  commissionConfirmedAt DateTime?           @map("commission_confirmed_at")

  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at")

  @@index([matchId, paymentStatus])
  @@map("match_payments")
}

enum CheckInStatus {
  PENDING_CHECK_IN
  CHECKED_IN
  NO_SHOW
}

model Booking {
  id                 Int           @id @default(autoincrement()) @map("id")
  bookingCode        String?       @unique @map("booking_code") @db.VarChar(50) // e.g. BK-001, BK-9831
  slotId             String?       @map("slot_id") @db.VarChar(50)
  slot               Slot?         @relation(fields: [slotId], references: [id], onDelete: Cascade)
  userId             String?       @map("user_id") @db.VarChar(50)
  user               User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  customerName       String        @map("customer_name") @db.VarChar(100)
  mobileNumber       String        @map("mobile_number") @db.VarChar(20)
  sportName          String?       @default("Cricket") @map("sport_name") @db.VarChar(50) // Cricket, Football
  courtName          String?       @default("Turf A") @map("court_name") @db.VarChar(100)  // Turf A, Turf B, Court 1
  timeSlot           String?       @default("10:00 AM") @map("time_slot") @db.VarChar(50)
  dutyDate           DateTime?     @map("duty_date") @db.Date
  amount             Decimal       @map("amount") @db.Decimal(10, 2)
  duration           Int           @default(60) @map("duration") // in minutes
  
  // Staff Shift Check-In Logs
  checkInStatus      CheckInStatus @default(PENDING_CHECK_IN) @map("check_in_status") // Checked-in, Pending, No-show
  checkedInAt        DateTime?     @map("checked_in_at")
  checkedInByStaffId String?       @map("checked_in_by_staff_id") @db.VarChar(50)
  
  notes              String?       @map("notes") @db.Text
  status             PaymentStatus @default(COMPLETED) @map("status")

  createdAt          DateTime      @default(now()) @map("created_at")

  // Relationships
  payments           Payment[]
  disputes           Dispute[]
  refundRequests     RefundRequest[]

  @@map("bookings")
}

// ------------------------------------------------------------------------------
// 7. CORPORATE BOOKINGS & TURF CRM MARKETING LEADS
// ------------------------------------------------------------------------------

model CorporateBooking {
  id               String               @id @map("id") @db.VarChar(50) // e.g. CORP-17870-X92A
  companyName      String               @map("company_name") @db.VarChar(150)
  contactPerson    String?              @map("contact_person") @db.VarChar(100)
  phone            String               @map("phone") @db.VarChar(20)
  email            String?              @map("email") @db.VarChar(100)
  eventType        String               @default("Corporate Tournament") @map("event_type") @db.VarChar(100)
