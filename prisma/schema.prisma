  phone           String       @map("phone") @db.VarChar(20)         // WhatsApp Mobile Number
  email           String?      @map("email") @db.VarChar(100)
  category        LeadCategory @default(CAPTAIN_TEAM) @map("category") // Team/Captain, Player, Umpire, Organizer, Corporate
  teamName        String?      @map("team_name") @db.VarChar(100)    // Team Name / Organization
  slotPreference  String?      @map("slot_preference") @db.VarChar(150) // e.g. "⏰18:00 (2026-08-09)", "Weekend Evenings"
  preferredSport  String?      @map("preferred_sport") @db.VarChar(50)
  status          LeadStatus   @default(NEW) @map("status")          // Hot Lead, NEW, Corporate Proposal, Active
