enum PosOrderType {
  TURF_BOOKING
  EQUIPMENT_RENTAL
  GAMING_SESSION
  SNACKS_REFRESHMENT
  MERCHANDISE
}

enum CustomerProfileType {
  GUEST
  MEMBER
  WALK_IN
}

model PosOrder {
  id               String              @id @default(cuid()) @map("id") @db.VarChar(50)
  invoiceNumber    String              @unique @map("invoice_number") @db.VarChar(50) // e.g. INV-1001, INV-1002
  branchId         String              @map("branch_id") @db.VarChar(50)
  branch           Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  
  customerName     String              @map("customer_name") @db.VarChar(100) // e.g. Amit Sharma
  customerPhone    String?             @map("customer_phone") @db.VarChar(20)
  customerType     CustomerProfileType @default(GUEST) @map("customer_type") // Guest, Member, Walk-in
  membershipId     String?             @map("membership_id") @db.VarChar(50)

  orderType        PosOrderType        @default(TURF_BOOKING) @map("order_type")
  sportName        String?             @default("Football") @map("sport_name") @db.VarChar(50)
  courtName        String?             @default("Court A (Main Turf)") @map("court_name") @db.VarChar(100)
  bookingDate      DateTime            @default(now()) @map("booking_date") @db.Date
  timeSlot         String?             @default("06:00 PM") @map("time_slot") @db.VarChar(50)
  durationMinutes  Int                 @default(60) @map("duration_minutes")
  playersCount     Int                 @default(10) @map("players_count")
  hourlyRate       Decimal             @default(1200.00) @map("hourly_rate") @db.Decimal(10, 2)

  // Extra Add-on Services Selected (JSON)
  // e.g. [{ name: "Flood Lights", price: 100 }, { name: "Sports Equipment", price: 200 }]
  addonServices    Json?               @map("addon_services")
  addonTotal       Decimal             @default(0.00) @map("addon_total") @db.Decimal(10, 2)
  
  subtotal         Decimal             @map("subtotal") @db.Decimal(10, 2)
  discountAmount   Decimal             @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  gstTaxRate       Decimal             @default(18.00) @map("gst_tax_rate") @db.Decimal(5, 2)
  gstAmount        Decimal             @default(0.00) @map("gst_amount") @db.Decimal(10, 2)
  grandTotal       Decimal             @map("grand_total") @db.Decimal(10, 2) // e.g. ₹1,534

  paymentMethod    PaymentMethod       @default(UPI) @map("payment_method") // UPI, Cash, Card, Wallet
  paymentStatus    PaymentStatus       @default(COMPLETED) @map("payment_status") // Paid, Pending
  notes            String?             @map("notes") @db.Text
  settledAt        DateTime?           @default(now()) @map("settled_at")
  createdAt        DateTime            @default(now()) @map("created_at")

  items            PosOrderItem[]

  @@index([branchId])
  @@index([paymentStatus])
  @@map("pos_orders")
}

model PosOrderItem {
  id         String   @id @default(cuid()) @map("id") @db.VarChar(50)
  orderId    String   @map("order_id") @db.VarChar(50)
  order      PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemName   String   @map("item_name") @db.VarChar(150)
  category   String?  @default("Turf Booking") @map("category") @db.VarChar(50)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(10, 2)
  quantity   Int      @default(1) @map("quantity")
  totalPrice Decimal  @map("total_price") @db.Decimal(10, 2)

  @@map("pos_order_items")
}

// ------------------------------------------------------------------------------
// 13. CLUB TEAMS & PLAYER PERFORMANCE ROSTER
// ------------------------------------------------------------------------------

model ClubTeam {
  id          String                  @id @default(cuid()) @map("id") @db.VarChar(50)
  branchId    String?                 @map("branch_id") @db.VarChar(50)
  branch      Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)

  teamName    String                  @map("team_name") @db.VarChar(100) // Vijay Nagar Blasters, Palasia Strikers FC
  sport       String                  @map("sport") @db.VarChar(50)      // Cricket, Football
  rosterCount Int                     @default(11) @map("roster_count")
  rank        String?                 @default("#1") @map("rank") @db.VarChar(20) // #1 Indore Hub, #3 Regional
  wins        Int                     @default(0) @map("wins")
  losses      Int                     @default(0) @map("losses")
  draws       Int                     @default(0) @map("draws")

  createdAt   DateTime                @default(now()) @map("created_at")
  players     ClubPlayer[]
  joinRequests TeamMembershipRequest[]

  @@map("club_teams")
}

model ClubPlayer {
  id            String    @id @default(cuid()) @map("id") @db.VarChar(50)
  teamId        String?   @map("team_id") @db.VarChar(50)
  team          ClubTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  playerName    String    @map("player_name") @db.VarChar(100) // Arjun Sharma, Priya Patel
  sport         String    @map("sport") @db.VarChar(50)      // Cricket, Football, Esports
  skillClass    String    @default("Advanced") @map("skill_class") @db.VarChar(50) // Expert, Advanced, Intermediate, Beginner
  matchesPlayed Int       @default(0) @map("matches_played")
  ratingScore   Decimal   @default(4.50) @map("rating_score") @db.Decimal(3, 1) // 4.8, 4.9
  status        String    @default("Active") @map("status") @db.VarChar(20)     // Active, Inactive

  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("club_players")
}

enum JoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model TeamMembershipRequest {
  id             String            @id @default(cuid()) @map("id") @db.VarChar(50)
  teamId         String            @map("team_id") @db.VarChar(50)
  team           ClubTeam          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId         String            @map("user_id") @db.VarChar(50)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  status         JoinRequestStatus @default(PENDING) @map("status")
  requestMessage String?           @map("request_message") @db.VarChar(255)
  createdAt      DateTime          @default(now()) @map("created_at")

  @@unique([teamId, userId])
  @@map("team_membership_requests")
}

// ------------------------------------------------------------------------------
// 14. CUSTOMER PROFILE, TRUST CENTER & EARNING ALERTS
// ------------------------------------------------------------------------------

model PlayerProfile {
  id                 String   @id @default(cuid()) @map("id") @db.VarChar(50)
  userId             String   @unique @map("user_id") @db.VarChar(50)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName           String   @map("full_name") @db.VarChar(100)            // e.g. Rahul Sharma
  playerTag          String   @default("Level 4 Pro Elite") @map("player_tag") @db.VarChar(100)
  
  // Trust Center & Verification Tier Progression (0 to 4)
  trustScore         Int      @default(98) @map("trust_score")              // 98/100 (98%)
  verificationLevel  Int      @default(4) @map("verification_level")        // Level 4 of 4 Reached
  isPhoneVerified    Boolean  @default(true) @map("is_phone_verified")      // Lvl 1
  isIdKycVerified    Boolean  @default(true) @map("is_id_kyc_verified")     // Lvl 2
  isMatchVerified    Boolean  @default(true) @map("is_match_verified")      // Lvl 3 (10+ handshakes)
  isUmpirePro        Boolean  @default(true) @map("is_umpire_pro")          // Lvl 4 (Tier 2/3 official)

  // Athletic Specialty & Performance
  primaryTeamName    String?  @default("Andheri Strikers") @map("primary_team_name") @db.VarChar(100) // Andheri Strikers, Vijay Nagar Blasters
  playingRole        String   @default("All-Rounder") @map("playing_role") @db.VarChar(50)
  battingStyle       String?  @default("Right-Hand Bat") @map("batting_style") @db.VarChar(50)
  bowlingStyle       String?  @default("Right-Arm Medium") @map("bowling_style") @db.VarChar(50)
  preferredSport     String   @default("Cricket") @map("preferred_sport") @db.VarChar(50)
  preferredSports    Json?    @map("preferred_sports") // e.g. ["Cricket", "Football", "Badminton"]
  city               String   @default("Indore") @map("city") @db.VarChar(100)
  areaHub            String?  @default("Vijay Nagar") @map("area_hub") @db.VarChar(100)
  
  highestScore       String?  @default("104*") @map("highest_score") @db.VarChar(20)
  bestBowlingFigures String?  @default("4/18") @map("best_bowling_figures") @db.VarChar(20)
  ppsScore           Decimal  @default(88.60) @map("pps_score") @db.Decimal(6, 2)
  cityRank           String?  @default("#4 Indore") @map("city_rank") @db.VarChar(50)

  // Match Counters
  totalMatches       Int      @default(28) @map("total_matches")
  totalWins          Int      @default(21) @map("total_wins")
  winRatePercent     Decimal  @default(75.00) @map("win_rate_percent") @db.Decimal(5, 2)
  tier3MatchesCount  Int      @default(8) @map("tier3_matches_count")  // 2.0x Official Tournaments
  tier2MatchesCount  Int      @default(12) @map("tier2_matches_count") // 1.5x Platform Umpire
  tier1MatchesCount  Int      @default(8) @map("tier1_matches_count")  // 1.0x Captain Handshake
  totalMvpAwards     Int      @default(9) @map("total_mvp_awards")

  // Earned Trust Badges: ["Paid Umpire Certified", "Tournament Veteran", "MVP Standard", "Zero Dispute Integrity"]
  earnedBadges       Json?    @map("earned_badges")

  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("player_profiles")
}

model OfferEarningAlert {
  id           String   @id @default(cuid()) @map("id") @db.VarChar(50)
  code         String   @unique @map("code") @db.VarChar(50) // e.g. MORNING20, DAREWINTURF, UMP-PAYOUT-500, IPL-INDORE-2026
  title        String   @map("title") @db.VarChar(150)
  description  String   @map("description") @db.Text
  category     String   @default("Discount Voucher") @map("category") @db.VarChar(50) // Discount Voucher, Dare Challenge, Umpire Earning Slot, Tournament Registration
  payoutAmount Decimal? @map("payout_amount") @db.Decimal(10, 2) // e.g. ₹500/match, ₹50,000 prize
  badgeText    String?  @default("Verified Offer") @map("badge_text") @db.VarChar(50)
  ctaText      String   @default("Claim Offer") @map("cta_text") @db.VarChar(100)
  ctaLink      String?  @map("cta_link") @db.VarChar(255)
  status       String   @default("ACTIVE") @map("status") @db.VarChar(20)

  createdAt    DateTime @default(now()) @map("created_at")

  @@map("offer_earning_alerts")
}

// ------------------------------------------------------------------------------
// 14. FINANCIAL TRANSACTIONS, ESCROW, BILLING & DISPUTES
// ------------------------------------------------------------------------------

model Payment {
  id            Int           @id @default(autoincrement()) @map("id")
  bookingId     Int?          @map("booking_id")
  booking       Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  userId        String?       @map("user_id") @db.VarChar(50)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  invoiceNumber String        @unique @map("invoice_number") @db.VarChar(50)
  customerName  String        @map("customer_name") @db.VarChar(100)
  type          String        @default("Booking") @map("type") @db.VarChar(50)
  amount        Decimal       @map("amount") @db.Decimal(10, 2)
  commission    Decimal       @default(0.00) @map("commission") @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(UPI) @map("payment_method")
  status        PaymentStatus @default(COMPLETED) @map("status")

  // Commission-split settlement (Phase 1 payment gateway abstraction) -- mirrors
  // MatchPayment's split fields for POS/billing payments. `commission` above is
  // the platform's cut; `ownerAmount` is what's due to the turf owner.
  ownerAmount       Decimal             @default(0.00) @map("owner_amount") @db.Decimal(10, 2)
  ownerPayoutStatus SettlementLegStatus @default(PENDING) @map("owner_payout_status")
  commissionStatus  SettlementLegStatus @default(PENDING) @map("commission_status")

  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([status])
  @@index([paymentMethod])
  @@map("payments")
}

model Dispute {
  id               String        @id @map("id") @db.VarChar(50)
  userId           String?       @map("user_id") @db.VarChar(50)
  user             User?         @relation("UserDisputes", fields: [userId], references: [id], onDelete: SetNull)
  bookingId        Int?          @map("booking_id")
  booking          Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  matchId          String?       @map("match_id") @db.VarChar(50)
  match            Match?        @relation(fields: [matchId], references: [id], onDelete: SetNull)

  customerName     String        @map("customer_name") @db.VarChar(100)
  type             DisputeType   @default(ESCROW) @map("type")
  amount           Decimal       @map("amount") @db.Decimal(10, 2)
  reason           String        @map("reason") @db.Text
  status           DisputeStatus @default(OPEN) @map("status")
  
  resolutionNotes  String?       @map("resolution_notes") @db.Text
  resolvedByUserId String?       @map("resolved_by_user_id") @db.VarChar(50)
  resolvedByUser   User?         @relation("ResolvedByAdmin", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  refundToWallet   Boolean       @default(false) @map("refund_to_wallet")
  resolutionDate   DateTime?     @map("resolution_date")

  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at")

  @@index([status])
  @@map("disputes")
}

// ------------------------------------------------------------------------------
// 15. WALLET, ESCROW HOLD & FINANCIAL LEDGER STATEMENTS
// ------------------------------------------------------------------------------

model Wallet {
  id                 String              @id @map("id") @db.VarChar(50)
  userId             String              @unique @map("user_id") @db.VarChar(50)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  balance            Decimal             @default(0.00) @map("balance") @db.Decimal(10, 2) // e.g. ₹1,24,500
  lockedEscrow       Decimal             @default(0.00) @map("locked_escrow") @db.Decimal(10, 2) // e.g. ₹5,000
  totalCommissionPaid Decimal            @default(0.00) @map("total_commission_paid") @db.Decimal(10, 2) // e.g. ₹28,640
  currency           String              @default("INR") @map("currency") @db.VarChar(10)
  bankAccountMasked  String?             @default("**** **** **** 8848") @map("bank_account_masked") @db.VarChar(30)

  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at")

  transactions       WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id                 Int          @id @default(autoincrement()) @map("id")
  walletId           String       @map("wallet_id") @db.VarChar(50)
  wallet             Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  
  transactionCode    String       @unique @map("transaction_code") @db.VarChar(50) // e.g. TXN-001, TXN-002
  type               WalletTxType @map("type") // BOOKING, TOURNAMENT, REFUND, TOP_UP, ESCROW_HOLD
  description        String       @map("description") @db.VarChar(255)
  
  grossAmount        Decimal      @map("gross_amount") @db.Decimal(10, 2)        // e.g. +₹800, +₹8,000
  platformCommission Decimal      @default(0.00) @map("platform_commission") @db.Decimal(10, 2) // e.g. -₹64 (8%)
  settledNet         Decimal      @map("settled_net") @db.Decimal(10, 2)         // e.g. ₹736, ₹7,360
  amount             Decimal      @map("amount") @db.Decimal(10, 2)
  status             String       @default("Completed") @map("status") @db.VarChar(50) // Completed, Held, Refunded

  createdAt          DateTime     @default(now()) @map("created_at")

  @@index([walletId])
  @@map("wallet_transactions")
}

// ------------------------------------------------------------------------------
// 16. SYSTEM SETTINGS & AUDIT LOGS
// ------------------------------------------------------------------------------

model SystemSetting {
  id                     String   @id @map("id") @db.VarChar(50)
  
  defaultRate            Decimal  @default(5.00) @map("default_rate") @db.Decimal(5, 2)
  maxRate                Decimal  @default(15.00) @map("max_rate") @db.Decimal(5, 2)
  minRate                Decimal  @default(2.00) @map("min_rate") @db.Decimal(5, 2)
  status                 String   @default("ACTIVE") @map("status") @db.VarChar(20)

  sportsRates            Json?    @map("sports_rates")
  
  gstTaxRate             Decimal  @default(18.00) @map("gst_tax_rate") @db.Decimal(5, 2)
  payoutFrequency        String   @default("WEEKLY") @map("payout_frequency") @db.VarChar(20)
  autoEscrowReleaseHours Int      @default(24) @map("auto_escrow_release_hours")

  maintenanceMode        Boolean  @default(false) @map("maintenance_mode")
  updatedBy              String?  @map("updated_by") @db.VarChar(50)
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("system_settings")
}

model ActivityLog {
  id         String   @id @default(cuid()) @map("id") @db.VarChar(50)
  userId     String?  @map("user_id") @db.VarChar(50)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action     String   @map("action") @db.VarChar(100)
  details    String   @map("details") @db.Text
  entityType String?  @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(50)
  ipAddress  String?  @map("ip_address") @db.VarChar(50)

  createdAt  DateTime @default(now()) @map("created_at")

  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

// ------------------------------------------------------------------------------
// 17. INVENTORY, STOCKS & CONSUMABLE ASSET MANAGEMENT
// ------------------------------------------------------------------------------

enum InventoryCategoryClass {
  EQUIPMENT
  CONSUMABLE
  SAFETY
}

enum InventoryStockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

model Inventory {
  id            String                 @id @map("id") @db.VarChar(50)
  branchId      String                 @map("branch_id") @db.VarChar(50)
  branch        Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  
  itemName      String                 @map("item_name") @db.VarChar(150) // Cricket Bats, Footballs, Shuttle Cocks, Water Bottles, First Aid Kit
  categoryClass InventoryCategoryClass @default(EQUIPMENT) @map("category_class")
  category      String?                @default("Equipment") @map("category") @db.VarChar(100)
  
  stockQuantity Int                    @default(0) @map("stock_quantity") // e.g. 12 Units, 3 Units, 48 Units
  minThreshold  Int                    @default(5) @map("min_threshold")   // Alert limit
  unitPrice     Decimal                @default(0.00) @map("unit_price") @db.Decimal(10, 2)
  assetValue    Decimal                @default(0.00) @map("asset_value") @db.Decimal(10, 2) // e.g. ₹18,000, ₹4,500
  condition     String?                @default("Good") @map("condition") @db.VarChar(50)   // Good, Fair, Damaged, N/A
  status        InventoryStockStatus   @default(IN_STOCK) @map("status")

  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @default(now()) @updatedAt @map("updated_at")

  purchases     PurchaseEntry[]
  rentals       EquipmentRental[]

  @@map("inventory")
}

model PurchaseEntry {
  id           Int       @id @default(autoincrement()) @map("id")
  inventoryId  String    @map("inventory_id") @db.VarChar(50)
  inventory    Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  quantity     Int       @map("quantity")
  purchaseCost Decimal   @map("purchase_cost") @db.Decimal(10, 2)
  supplier     String?   @map("supplier") @db.VarChar(150)
  purchaseDate DateTime  @default(now()) @map("purchase_date")

  @@map("purchase_entries")
}

// ------------------------------------------------------------------------------
// 18. MECHANICAL LOGS & COURT MAINTENANCE DESK
// ------------------------------------------------------------------------------

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  SCHEDULED
  COMPLETED
}

model MaintenanceTask {
  id                 String              @id @map("id") @db.VarChar(50) // e.g. MT-001, MT-002
  branchId           String              @map("branch_id") @db.VarChar(50)
  branch             Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)

  issueDescription   String              @map("issue_description") @db.VarChar(255) // "Re-paint court lines", "Fix floodlight #3"
  turfArea           String              @default("Turf A Field") @map("turf_area") @db.VarChar(100) // Turf A, Turf B, Court 1, Facility
  assignedSpecialist String              @default("Staff Team") @map("assigned_specialist") @db.VarChar(100) // Ravi Kumar, Suresh P.
  priorityLevel      MaintenancePriority @default(MEDIUM) @map("priority_level") // Urgent, High, Medium, Low
  targetDeadline     DateTime?           @map("target_deadline") @db.Date // 2026-03-05
  status             MaintenanceStatus   @default(OPEN) @map("status") // Open, In Progress, Scheduled, Completed
  notes              String?             @map("notes") @db.Text

  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at")

  @@index([branchId, status])
  @@map("maintenance_tasks")
}

// ------------------------------------------------------------------------------
// 19. STAFF OPERATIONS, SHIFTS & ROLES
// ------------------------------------------------------------------------------

enum StaffShiftSlot {
  MORNING_SHIFT
  EVENING_SHIFT
  NIGHT_SHIFT
  FULL_DAY_SHIFT
}

enum StaffRoleType {
  BRANCH_MANAGER
  TECHNICIAN
  CASHIER
  GROUND_STAFF
}

model StaffMember {
  id          String         @id @default(cuid()) @map("id") @db.VarChar(50)
  branchId    String         @map("branch_id") @db.VarChar(50)
  branch      Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // Links this roster entry to a real, login-capable User (role STAFF). Without
  // this, "adding a staff member" was only ever a roster row with no way to
  // actually log in scoped to the branch.
  userId      String?        @unique @map("user_id") @db.VarChar(50)
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  fullName    String         @map("full_name") @db.VarChar(100) // Ravi Kumar, Suresh Patil, Anita Desai
  email       String         @map("email") @db.VarChar(100)
  phone       String         @map("phone") @db.VarChar(20)      // +91 98765 43210
  role        StaffRoleType  @default(BRANCH_MANAGER) @map("role") // Branch Manager, Technician, Cashier
  shiftSlot   StaffShiftSlot @default(MORNING_SHIFT) @map("shift_slot") // Morning Slot, Evening Slot, Night Slot, Full Day
  status      String         @default("Active") @map("status") @db.VarChar(20) // Active, Inactive

  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at")

  @@index([branchId])
  @@map("staff_members")
}

// ------------------------------------------------------------------------------
// 20. STAFF OPERATIONS: EQUIPMENT HANDOVER & REFUND WORKFLOW
// ------------------------------------------------------------------------------

enum EquipmentRentalStatus {
  RENTED
  RETURNED
  DAMAGED
  LOST
  OVERDUE
}

model EquipmentRental {
  id              String                @id @default(cuid()) @map("id") @db.VarChar(50)
  rentalCode      String                @unique @map("rental_code") @db.VarChar(50) // e.g. RENT-2026-101
  branchId        String                @map("branch_id") @db.VarChar(50)
  branch          Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  inventoryId     String?               @map("inventory_id") @db.VarChar(50)
  inventory       Inventory?            @relation(fields: [inventoryId], references: [id], onDelete: SetNull)

  itemName        String                @map("item_name") @db.VarChar(100) // Cricket Bat, Football, Badminton Racket
  customerName    String                @map("customer_name") @db.VarChar(100)
  customerPhone   String?               @map("customer_phone") @db.VarChar(20)
  quantity        Int                   @default(1) @map("quantity")
  rentalFee       Decimal               @default(0.00) @map("rental_fee") @db.Decimal(10, 2)
  depositAmount   Decimal               @default(0.00) @map("deposit_amount") @db.Decimal(10, 2) // Refundable security deposit
  
  issuedByStaffId String?               @map("issued_by_staff_id") @db.VarChar(50)
  issuedAt        DateTime              @default(now()) @map("issued_at")
  dueReturnAt     DateTime?             @map("due_return_at")
  returnedAt      DateTime?             @map("returned_at")
  returnCondition String?               @default("Good") @map("return_condition") @db.VarChar(50) // Good, Damaged, Normal Wear
  status          EquipmentRentalStatus @default(RENTED) @map("status")

  createdAt       DateTime              @default(now()) @map("created_at")

  @@index([branchId, status])
  @@map("equipment_rentals")
}

enum RefundRequestStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  REFUNDED
}

model RefundRequest {
  id                 String              @id @default(cuid()) @map("id") @db.VarChar(50)
  ticketNumber       String              @unique @map("ticket_number") @db.VarChar(50) // e.g. REF-2026-001
  branchId           String              @map("branch_id") @db.VarChar(50)
  branch             Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  bookingId          Int?                @map("booking_id")
  booking            Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  customerName       String              @map("customer_name") @db.VarChar(100)
  customerPhone      String?             @map("customer_phone") @db.VarChar(20)
  amount             Decimal             @map("amount") @db.Decimal(10, 2)
  reason             String              @map("reason") @db.Text // Rain cancellation, pitch maintenance, double charge
  requestedByStaffId String?             @map("requested_by_staff_id") @db.VarChar(50)
  
  status             RefundRequestStatus @default(PENDING_REVIEW) @map("status")
  adminNotes         String?             @map("admin_notes") @db.Text
  approvedByUserId   String?             @map("approved_by_user_id") @db.VarChar(50)
  refundedToWallet   Boolean             @default(true) @map("refunded_to_wallet")

  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at")

  @@index([branchId, status])
  @@map("refund_requests")
}

// ------------------------------------------------------------------------------
// 21. VENUE HOLIDAYS, REVIEWS & CONTACT INQUIRIES
// ------------------------------------------------------------------------------

model Holiday {
  id          String   @id @map("id") @db.VarChar(50)
  branchId    String   @map("branch_id") @db.VarChar(50)
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  title       String   @map("title") @db.VarChar(150)
  holidayDate DateTime @map("holiday_date") @db.Date
  reason      String?  @map("reason") @db.VarChar(255)
  isFullDay   Boolean  @default(true) @map("is_full_day")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("holidays")
}

model Review {
  id               String   @id @default(cuid()) @map("id") @db.VarChar(50)
  branchId         String   @map("branch_id") @db.VarChar(50)
  branch           Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId           String?  @map("user_id") @db.VarChar(50)
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  authorName       String   @map("author_name") @db.VarChar(100)
  rating           Decimal  @map("rating") @db.Decimal(2, 1)
  comment          String?  @map("comment") @db.Text
  isVerifiedBooking Boolean @default(true) @map("is_verified_booking")

  createdAt        DateTime @default(now()) @map("created_at")

  @@map("reviews")
}

model ContactMessage {
  id        String   @id @default(cuid()) @map("id") @db.VarChar(50)
  fullName  String   @map("full_name") @db.VarChar(100)
  email     String   @map("email") @db.VarChar(100)
  subject   String?  @map("subject") @db.VarChar(150)
  message   String   @map("message") @db.Text
  status    String   @default("UNREAD") @map("status") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

// ------------------------------------------------------------------------------
// 22. EXPRESS GUEST BOOKINGS & RESERVATIONS
// ------------------------------------------------------------------------------

model GuestBooking {
  id            String   @id @map("id") @db.VarChar(50) // e.g. GUEST-1740000000
  sport         String   @map("sport") @db.VarChar(50)  // Cricket, Football, Badminton
  venue         String   @map("venue") @db.VarChar(150) // Champions Turf Ground, SkyLine Arena
  date          DateTime @map("date") @db.Date
  time          String   @map("time") @db.VarChar(50)   // 06:00 PM
  amount        Decimal  @map("amount") @db.Decimal(10, 2)
  status        String   @default("Confirmed") @map("status") @db.VarChar(20)
  customerName  String?  @map("customer_name") @db.VarChar(100)
  customerPhone String?  @map("customer_phone") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("guest_bookings")
}

// ------------------------------------------------------------------------------
// 23. REMOTE MATCH LIVE SCORING & MOBILE CONTROLLER DESK
// ------------------------------------------------------------------------------

model LiveMatchSession {
  id            String    @id @map("id") @db.VarChar(100) // e.g. sessionId (ctrl_session_xyz)
  matchId       String?   @map("match_id") @db.VarChar(50)
  match         Match?    @relation(fields: [matchId], references: [id], onDelete: SetNull)

  status        String    @default("valid") @map("status") @db.VarChar(20) // valid, expired, invalid, disconnected
  deviceInfo    Json?     @map("device_info") // { platform: "Android Chrome", browser: "Mobile Web", time: "18:45:00" }
  matchSnapshot Json?     @map("match_snapshot") // { overs, balls, totalRuns, wickets, extras, striker, nonStriker, bowler }
  lastSyncedAt  DateTime  @default(now()) @updatedAt @map("last_synced_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("live_match_sessions")
}

// ------------------------------------------------------------------------------
// 24. PLUGGABLE PAYMENT GATEWAY & OWNER COMMISSION-SPLIT PAYOUTS
// ------------------------------------------------------------------------------
// No live payment gateway is wired in yet. Every booking payment still records a
// real commission/owner split (same commission-rate math MatchPricingService
// already performs), and now requires the owner to confirm receipt and the
// platform to confirm its commission before the payment is COMPLETED. Swapping
// PaymentGatewayConfig.activeProvider to a real gateway later (e.g. RAZORPAY_ROUTE)
// activates automatic split settlement without further schema changes.

enum SettlementLegStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum PaymentGatewayProviderType {
  MANUAL
  RAZORPAY_ROUTE
  STRIPE_CONNECT
}

enum OwnerPayoutAccountType {
  UPI
  BANK_ACCOUNT
  QR_CODE
}

model OwnerPayoutAccount {
  id                String                 @id @default(cuid()) @map("id") @db.VarChar(50)
  branchId          String                 @unique @map("branch_id") @db.VarChar(50)
  branch            Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)

  accountType       OwnerPayoutAccountType @default(UPI) @map("account_type")
  upiId             String?                @map("upi_id") @db.VarChar(100)
  bankAccountHolder String?                @map("bank_account_holder") @db.VarChar(150)
  bankAccountNumber String?                @map("bank_account_number") @db.VarChar(50)
  bankIfsc          String?                @map("bank_ifsc") @db.VarChar(20)
  bankName          String?                @map("bank_name") @db.VarChar(100)
  qrCodeImageUrl    String?                @map("qr_code_image_url") @db.VarChar(255)
  isActive          Boolean                @default(true) @map("is_active")

  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @default(now()) @updatedAt @map("updated_at")

  @@map("owner_payout_accounts")
}

model PaymentGatewayConfig {
  id             String                     @id @map("id") @db.VarChar(50) // singleton row: "global_gateway"
  activeProvider PaymentGatewayProviderType @default(MANUAL) @map("active_provider")
  isLiveMode     Boolean                    @default(false) @map("is_live_mode")

  razorpayKeyId         String? @map("razorpay_key_id") @db.VarChar(150)
  razorpayKeySecret      String? @map("razorpay_key_secret") @db.VarChar(150)
  razorpayWebhookSecret String? @map("razorpay_webhook_secret") @db.VarChar(150)

  stripeSecretKey     String? @map("stripe_secret_key") @db.VarChar(150)
  stripeWebhookSecret String? @map("stripe_webhook_secret") @db.VarChar(150)

  updatedBy String?  @map("updated_by") @db.VarChar(50)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("payment_gateway_configs")
}

