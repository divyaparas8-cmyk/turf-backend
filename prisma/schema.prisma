model Scorecard {
  id                String          @id @default(cuid()) @map("id") @db.VarChar(50)
  playerName        String          @map("player_name") @db.VarChar(100)
  teamName          String          @map("team_name") @db.VarChar(100)
  city              String          @default("Indore") @map("city") @db.VarChar(100)
  areaHub           String?         @default("Vijay Nagar") @map("area_hub") @db.VarChar(100) // Vijay Nagar, Palasia, Bhawarkua, Super Corridor, Rau
  playingRole       String          @default("All-Rounder") @map("playing_role") @db.VarChar(50)

  tier              LeaderboardTier @default(PAID_UMPIRE) @map("tier")
  weightMultiplier  Decimal         @default(1.50) @map("weight_multiplier") @db.Decimal(3, 2)

  rankPosition      Int?            @map("rank_position") // #1 Gold, #2 Silver, #3 Bronze, etc.
  matches           Int             @default(0) @map("matches")
  runs              Int             @default(0) @map("runs")
  ballsFaced        Int?            @default(0) @map("balls_faced")
  fours             Int?            @default(0) @map("fours")
  sixes             Int?            @default(0) @map("sixes")
  battingAvg        Decimal         @default(0.00) @map("batting_avg") @db.Decimal(5, 2)
  strikeRate        Decimal         @default(0.00) @map("strike_rate") @db.Decimal(5, 2)
  
  wickets           Int             @default(0) @map("wickets")
  oversBowled       Decimal?        @default(0.00) @map("overs_bowled") @db.Decimal(4, 1)
  economy           Decimal         @default(0.00) @map("economy") @db.Decimal(4, 2)
  mvpCount          Int             @default(0) @map("mvp_count")

  ppsScore          Decimal         @default(0.00) @map("pps_score") @db.Decimal(6, 2)
  certifierUmpireId String?         @map("certifier_umpire_id") @db.VarChar(50)

  verifiedByUserId  String?         @map("verified_by_user_id") @db.VarChar(50)
  verifiedByUser    User?           @relation("UmpireVerifications", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at")

  @@index([city, ppsScore])
  @@index([tier])
  @@map("scorecards")
}

model PlayerScoreSubmission {
  id                String          @id @default(cuid()) @map("id") @db.VarChar(50) // e.g. MSS-IND-1001
  userId            String?         @map("user_id") @db.VarChar(50)
  user              User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  playerName        String          @map("player_name") @db.VarChar(100)
  teamName          String          @map("team_name") @db.VarChar(100)
  city              String          @default("Indore") @map("city") @db.VarChar(100)
  areaHub           String          @default("Vijay Nagar") @map("area_hub") @db.VarChar(100)
  playingRole       String          @default("All-Rounder") @map("playing_role") @db.VarChar(50)

  verificationTier  LeaderboardTier @default(PAID_UMPIRE) @map("verification_tier") // 1.0x, 1.5x, 2.0x
  weightMultiplier  Decimal         @default(1.50) @map("weight_multiplier") @db.Decimal(3, 2)

  // Batting Stats
  runsScored        Int             @default(0) @map("runs_scored")
  ballsFaced        Int             @default(0) @map("balls_faced")
  fours             Int             @default(0) @map("fours")
  sixes             Int             @default(0) @map("sixes")
  strikeRate        Decimal         @default(0.00) @map("strike_rate") @db.Decimal(5, 2)

  // Bowling Stats
  wicketsTaken      Int             @default(0) @map("wickets_taken")
  oversBowled       Decimal         @default(0.0) @map("overs_bowled") @db.Decimal(4, 1)
  economyRate       Decimal         @default(0.00) @map("economy_rate") @db.Decimal(4, 2)

  isMvpAwarded      Boolean         @default(false) @map("is_mvp_awarded") // +12 pts
  certifierUmpireId String?         @map("certifier_umpire_id") @db.VarChar(50) // e.g. LIC: UMP-IND-409
  computedPps       Decimal         @default(0.00) @map("computed_pps") @db.Decimal(6, 2)

  status            String          @default("APPROVED_AND_RANKED") @map("status") @db.VarChar(30)
  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([city, areaHub])
  @@map("player_score_submissions")
}

model MatchHandshake {
  id                      String          @id @default(cuid()) @map("id") @db.VarChar(50)
  matchId                 String          @unique @map("match_id") @db.VarChar(50)
  match                   Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)

  // Official Match Record Certification
  certificateCode         String?         @unique @map("certificate_code") @db.VarChar(50) // e.g. CERT-#MTC-98432
  captainAApproved        Boolean         @default(false) @map("captain_a_approved")
  captainBApproved        Boolean         @default(false) @map("captain_b_approved")
  umpireApproved          Boolean         @default(false) @map("umpire_approved")
  verificationTier        LeaderboardTier @default(PAID_UMPIRE) @map("verification_tier") // 1.0x, 1.5x, 2.0x
  
  // Results & MVP Award
  matchResultText         String?         @map("match_result_text") @db.VarChar(200) // "Vijay Nagar Blasters (You) won by 12 runs"
  firstInningsScore       String?         @map("first_innings_score") @db.VarChar(50) // "148/4 (16.0 ov)"
  secondInningsScore      String?         @map("second_innings_score") @db.VarChar(50) // "136/7 (16.0 ov)"
  mvpPlayerName           String?         @map("mvp_player_name") @db.VarChar(100) // "Rahul Sharma"
  mvpStats                String?         @map("mvp_stats") @db.VarChar(150) // "58 Runs off 32 balls"
  mvpRankPoints           Int             @default(12) @map("mvp_rank_points") // +12 Rank PTS
  scorerName              String?         @map("scorer_name") @db.VarChar(100) // "Sunil Gavaskar (Level 2 Certified Umpire)"

  // Detailed Inning Scorecard Tables (JSON)
  // Batter rows: [{ batter: "Rahul Sharma (C)", runs: 58, balls: 32, fours: 6, sixes: 3, strikeRate: 181.2 }]
  firstInningsBattingJson  Json?           @map("first_innings_batting_json")
  secondInningsBattingJson Json?           @map("second_innings_batting_json")
  bowlingFiguresJson       Json?           @map("bowling_figures_json")
  scoreDataJson           Json?           @map("score_data_json")

  // Confirmation Clock (e.g. ⏳ 36 hrs left)
  confirmationDeadline    DateTime?       @map("confirmation_deadline")
  hoursRemaining          Int?            @default(36) @map("hours_remaining")

  disputeRaised           Boolean         @default(false) @map("dispute_raised")
  disputeReason           String?         @map("dispute_reason") @db.Text
  isRatified              Boolean         @default(false) @map("is_ratified")

  verifiedAt              DateTime?       @map("verified_at")
  createdAt               DateTime        @default(now()) @map("created_at")

  @@map("match_handshakes")
}

// ------------------------------------------------------------------------------
// 12. OFFICIAL UMPIRE & REFEREE LEVEL-2 SYSTEM
// ------------------------------------------------------------------------------

enum UmpireDutyStatus {
  SCHEDULED
  LIVE_NOW
  CERTIFIED_COMPLETED
  DISPUTED
}

enum UmpireFeeStatus {
  PENDING
  RECEIVED
}

model UmpireProfile {
  id                      String                 @id @default(cuid()) @map("id") @db.VarChar(50)
  userId                  String                 @unique @map("user_id") @db.VarChar(50)
  user                    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  licenseNumber           String                 @unique @map("license_number") @db.VarChar(50) // e.g. UMP-IND-409
  fullName                String                 @map("full_name") @db.VarChar(100)
  certificationLevel      String?                @map("certification_level") @db.VarChar(100)
  officiatingLocations    String?                @map("officiating_locations") @db.VarChar(200)
  city                    String?                @map("city") @db.VarChar(100)
  
  // Direct UPI QR Setup
  upiId                   String?                @map("upi_id") @db.VarChar(100)
  qrImageUrl              String?                @map("qr_image_url") @db.VarChar(255)
  dutyFeePerMatch         Decimal                @default(300.00) @map("duty_fee_per_match") @db.Decimal(10, 2)
  
  isOnDuty                Boolean                @default(true) @map("is_on_duty") // ON DUTY / OFF DUTY
  leaderboardTier         LeaderboardTier        @default(PAID_UMPIRE) @map("leaderboard_tier") // 1.5x Points
  totalMatchesOfficiated  Int                    @default(0) @map("total_matches_officiated")
  totalCertifiedScorecards Int                   @default(0) @map("total_certified_scorecards")
  rating                  Decimal                @default(5.00) @map("rating") @db.Decimal(3, 2)
  status                  UserStatus             @default(ACTIVE) @map("status")

  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @default(now()) @updatedAt @map("updated_at")

  dutyAssignments         UmpireDutyAssignment[]

  @@map("umpire_profiles")
}

model UmpireDutyAssignment {
  id                   String           @id @map("id") @db.VarChar(50) // e.g. MTC-IND-901, MTC-IND-902
  matchId              String           @unique @map("match_id") @db.VarChar(50)
  match                Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  branchId             String           @map("branch_id") @db.VarChar(50)
  branch               Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  umpireProfileId      String           @map("umpire_profile_id") @db.VarChar(50)
  umpireProfile        UmpireProfile    @relation(fields: [umpireProfileId], references: [id], onDelete: Cascade)

  dutyFee              Decimal          @default(300.00) @map("duty_fee") @db.Decimal(10, 2)
  feePaymentStatus     UmpireFeeStatus  @default(RECEIVED) @map("fee_payment_status") // Received, Pending

  // Toss & Live Scoring Desk
  tossWinnerTeam       String?          @map("toss_winner_team") @db.VarChar(100) // Annapurna Strikers, Super Corridor Titans
  tossElected          String?          @map("toss_elected") @db.VarChar(20)      // BAT, BOWL
  ballByBallFeed       Json?            @map("ball_by_ball_feed")                 // [1, 4, 0, 6, "W", 1]
  currentScoreSummary  String?          @map("current_score_summary") @db.VarChar(100) // "74/3 (5.2 Overs)", Target "75"
  
  // Top Performers & MVP Push (1.5x Indore Leaderboard)
  topBatsmanName       String?          @map("top_batsman_name") @db.VarChar(100) // Rahul Sharma
  topBatsmanRuns       Int?             @default(0) @map("top_batsman_runs")      // 58
  topBatsmanBalls      Int?             @default(0) @map("top_batsman_balls")     // 32
  topBowlerName        String?          @map("top_bowler_name") @db.VarChar(100)  // Aman Verma
  topBowlerWickets     Int?             @default(0) @map("top_bowler_wickets")    // 3
  topBowlerRuns        Int?             @default(0) @map("top_bowler_runs")       // 22
  matchMvpName         String?          @map("match_mvp_name") @db.VarChar(100)   // Rahul Sharma
  matchMvpPhone        String?          @map("match_mvp_phone") @db.VarChar(20)   // +91 98765 43210
  isLeaderboardPushed  Boolean          @default(false) @map("is_leaderboard_pushed")

  dutyStatus           UmpireDutyStatus @default(LIVE_NOW) @map("duty_status") // SCHEDULED, LIVE_NOW, CERTIFIED_COMPLETED, DISPUTED
  certifiedAt          DateTime?        @map("certified_at")

  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at")

  @@index([umpireProfileId, dutyStatus])
  @@map("umpire_duty_assignments")
}

