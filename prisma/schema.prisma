// ------------------------------------------------------------------------------
// 8. ADVERTISING MANAGEMENT & 4-STEP CAMPAIGN CREATOR
// ------------------------------------------------------------------------------

model Advertisement {
  id             String       @id @map("id") @db.VarChar(50) // e.g. AD-1001
  branchId       String       @default("br_001") @map("branch_id") @db.VarChar(50)
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ownerId        String?      @map("owner_id") @db.VarChar(50)
  owner          Owner?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  name           String       @map("name") @db.VarChar(150) // Campaign name
  type           AdType       @default(GUARANTEED_BOOKING) @map("type")
  status         AdStatus     @default(ACTIVE) @map("status")
  icon           String?      @default("📢") @map("icon") @db.VarChar(10)

  // Step 2 & 3: Budget, Duration & Financial Rules
  durationMonths Int          @default(1) @map("duration_months") // 1, 2, 3, 6, 12 Months
  budgetTotal    Decimal      @default(5000.00) @map("budget_total") @db.Decimal(10, 2)
  dailyBudget    Decimal      @default(500.00) @map("daily_budget") @db.Decimal(10, 2)
  budgetSpent    Decimal      @default(0.00) @map("budget_spent") @db.Decimal(10, 2)
  commissionRate Decimal      @default(12.00) @map("commission_rate") @db.Decimal(5, 2) // e.g. 15%
  commissionPaid Decimal      @default(0.00) @map("commission_paid") @db.Decimal(10, 2)
  bookingGoal    Int          @default(30) @map("booking_goal")
  avgSlotPrice   Decimal      @default(1500.00) @map("avg_slot_price") @db.Decimal(10, 2)
  targetRadiusKm Int          @default(5) @map("target_radius_km")
  estimatedReach Int          @default(12500) @map("estimated_reach")
  revenue        Decimal      @default(0.00) @map("revenue") @db.Decimal(10, 2)

  // Performance Analytics
  views          Int          @default(0) @map("views")
  clicks         Int          @default(0) @map("clicks")
  bookings       Int          @default(0) @map("bookings")
  ctr            String?      @default("0%") @map("ctr") @db.VarChar(20)
  roi            String?      @default("0%") @map("roi") @db.VarChar(20)
  cpa            String?      @default("₹0") @map("cpa") @db.VarChar(20)

  // Schedule & Details
  startDate      DateTime     @map("start_date") @db.Date
  endDate        DateTime     @map("end_date") @db.Date
  description    String?      @map("description") @db.Text

  // Impression Ad Creative (only used when type = IMPRESSION_AD)
  adTitle             String?  @map("ad_title") @db.VarChar(150)
  shortHeadline       String?  @map("short_headline") @db.VarChar(150)
  ctaText             String?  @map("cta_text") @db.VarChar(50)
  redirectUrl         String?  @map("redirect_url") @db.VarChar(500)
  bannerImageUrl      String?  @map("banner_image_url") @db.Text
  mobileBannerImageUrl String? @map("mobile_banner_image_url") @db.Text
  thumbnailImageUrl   String?  @map("thumbnail_image_url") @db.Text
  videoUrl            String?  @map("video_url") @db.Text
  pricingModel        String?  @map("pricing_model") @db.VarChar(20) // CPM, CPC etc.
  cpmRate             Decimal? @map("cpm_rate") @db.Decimal(10, 2)
  placements          String?  @map("placements") @db.VarChar(500) // comma-separated placement slots

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at")

  // Relationships
  commissions    AdCommission[]
  payments       AdPayment[]

  @@map("advertisements")
}

model AdCommission {
  id               String             @id @default(cuid()) @map("id") @db.VarChar(50)
  adId             String             @map("ad_id") @db.VarChar(50)
  advertisement    Advertisement      @relation(fields: [adId], references: [id], onDelete: Cascade)
  ownerId          String?            @map("owner_id") @db.VarChar(50)
  owner            Owner?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  branchId         String             @map("branch_id") @db.VarChar(50)
  branch           Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)

  bookingId        String             @map("booking_id") @db.VarChar(50) // e.g. BK-9021
  bookingAmount    Decimal            @map("booking_amount") @db.Decimal(10, 2)
  commissionRate   Decimal            @map("commission_rate") @db.Decimal(5, 2)
  commissionAmount Decimal            @map("commission_amount") @db.Decimal(10, 2)
  ownerAmount      Decimal            @map("owner_amount") @db.Decimal(10, 2)
  invoiceNumber    String             @map("invoice_number") @db.VarChar(50) // e.g. INV-2026-001
  status           AdCommissionStatus @default(PENDING) @map("status")

  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at")

  @@index([adId])
  @@index([status])
  @@map("ad_commissions")
}

model AdPayment {
  id                  String        @id @default(cuid()) @map("id") @db.VarChar(50)
  invoiceNumber       String        @unique @map("invoice_number") @db.VarChar(50) // e.g. INV-2026-803
  adId                String        @map("ad_id") @db.VarChar(50)                  // e.g. AD-1003
  advertisement       Advertisement @relation(fields: [adId], references: [id], onDelete: Cascade)
  ownerId             String?       @map("owner_id") @db.VarChar(50)
  owner               Owner?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  branchId            String        @map("branch_id") @db.VarChar(50)
  branch              Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // GST Tax Invoice Details
  billingDate         DateTime      @default(now()) @map("billing_date") @db.Date
  gstRegistration     String        @default("27AAAAA0000A1Z5") @map("gst_registration") @db.VarChar(50)
  campaignName        String?       @map("campaign_name") @db.VarChar(150) // e.g. Top Impression Push
  turfOwnerName       String?       @map("turf_owner_name") @db.VarChar(100)
  paymentMode         String        @default("Razorpay Payout") @map("payment_mode") @db.VarChar(50)
  
  // Breakdown
  baseAmount          Decimal?      @map("base_amount") @db.Decimal(10, 2)
  gstAmount           Decimal?      @default(0.00) @map("gst_amount") @db.Decimal(10, 2)
  totalAmount         Decimal       @map("total_amount") @db.Decimal(10, 2) // e.g. ₹25,000
  payoutRefNumber     String?       @map("payout_ref_number") @db.VarChar(100)
  receiptPdfUrl       String?       @map("receipt_pdf_url") @db.VarChar(255)
  status              PaymentStatus @default(COMPLETED) @map("status") // Paid, Pending, Failed

  createdAt           DateTime      @default(now()) @map("created_at")

  @@index([adId])
  @@index([ownerId])
  @@map("ad_payments")
}

// ------------------------------------------------------------------------------
// 9. FULL 4-STEP DISCOUNT OFFERS & PROMOTIONAL COUPONS ENGINE
// ------------------------------------------------------------------------------

model DiscountOffer {
  id                    String         @id @map("id") @db.VarChar(50) // e.g. disc_101, disc_1786615971386
  branchId              String         @map("branch_id") @db.VarChar(50)
  branch                Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ownerId               String?        @map("owner_id") @db.VarChar(50)
  owner                 Owner?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  // Step 1: Basic Offer Details
  title                 String         @map("title") @db.VarChar(150)
  description           String?        @map("description") @db.Text
  discountType          DiscountType   @default(PERCENTAGE) @map("discount_type") // Percentage (%) or Flat Amount (₹)
  promoCode             String?        @map("promo_code") @db.VarChar(50)        // e.g. MONSOON25, MORNING300
  banner                String?        @map("banner") @db.VarChar(255)
  thumbnail             String?        @map("thumbnail") @db.VarChar(255)

  // Step 2: Discount Configuration & Slot Rules
  discountValue         Decimal        @map("discount_value") @db.Decimal(10, 2) // 25 (%) or 300 (₹)
  minimumBookingAmount  Decimal        @default(0.00) @map("minimum_booking_amount") @db.Decimal(10, 2)
  maximumDiscountAmount Decimal        @default(0.00) @map("maximum_discount_amount") @db.Decimal(10, 2)
  applicableSlotTypes   Json?          @map("applicable_slot_types") // ["Morning", "Afternoon", "Evening", "Night"]
  applicableDays        Json?          @map("applicable_days")       // ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
  applicableSports      Json?          @map("applicable_sports")     // ["Football", "Cricket", "Badminton", "Tennis", "Box Cricket"]
  
  startDate             DateTime       @map("start_date") @db.Date
  endDate               DateTime       @map("end_date") @db.Date
  startTime             String?        @default("00:00:00") @map("start_time") @db.VarChar(20)
  endTime               String?        @default("23:59:59") @map("end_time") @db.VarChar(20)
  
  usageLimit            Int            @default(200) @map("usage_limit")
  usedCount             Int            @default(0) @map("used_count")
  perUserLimit          Int            @default(1) @map("per_user_limit")
  firstBookingOnly      Boolean        @default(false) @map("first_booking_only")
  stackable             Boolean        @default(false) @map("stackable")
  autoApply             Boolean        @default(false) @map("auto_apply")

  // Step 3: Audience & Geo Targeting
  targetRadiusKm        Decimal        @default(5.00) @map("target_radius_km") @db.Decimal(5, 2)
  locationArea          String?        @map("location_area") @db.VarChar(100)
  customerType          String         @default("All Users") @map("customer_type") @db.VarChar(50)
  genderSegment         String         @default("All Genders") @map("gender_segment") @db.VarChar(50)
  ageGroup              String         @default("All Ages") @map("age_group") @db.VarChar(50)
  estimatedAudience     Int            @default(12500) @map("estimated_audience")

  status                DiscountStatus @default(ACTIVE) @map("status") // Draft, Active, Scheduled, Expired
  createdBy             String?        @map("created_by") @db.VarChar(50)
  deletedAt             DateTime?      @map("deleted_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @default(now()) @updatedAt @map("updated_at")

  @@index([branchId, status])
  @@index([promoCode])
  @@map("discount_offers")
}

// ------------------------------------------------------------------------------
// 10. TOURNAMENTS, SQUADS, FIXTURES, SPONSORS & COMMAND CENTER
// ------------------------------------------------------------------------------

model TournamentCategory {
  id          String       @id @map("id") @db.VarChar(50)
  name        String       @unique @map("name") @db.VarChar(50) // e.g. Cricket, Football, Badminton
  icon        String?      @default("🏆") @map("icon") @db.VarChar(10)
  description String?      @map("description") @db.Text
  createdAt   DateTime     @default(now()) @map("created_at")

  tournaments Tournament[]

  @@map("tournament_categories")
}

model Tournament {
  id                      String             @id @map("id") @db.VarChar(50) // e.g. t_001
  branchId                String             @map("branch_id") @db.VarChar(50)
  branch                  Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sportId                 String             @map("sport_id") @db.VarChar(50)
  sport                   Sport              @relation(fields: [sportId], references: [id], onDelete: Cascade)
  categoryId              String?            @map("category_id") @db.VarChar(50)
  category                TournamentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Section 1: Tournament Identity & Sport
  title                   String             @map("title") @db.VarChar(150) // e.g. "Monsoon Cricket Super Cup 2026"
  description             String?            @map("description") @db.Text
  bannerImage             String?            @map("banner_image") @db.Text
  organizerName           String             @default("SportMatrix Events Team") @map("organizer_name") @db.VarChar(100)
  organizerContactNumber  String             @default("+91 98765 43210") @map("organizer_contact_number") @db.VarChar(20)
  tournamentRules         String?            @map("tournament_rules") @db.Text

  // Section 2: Date & Turf Schedule
  registrationStartDate   DateTime?          @map("registration_start_date") @db.Date
  registrationLastDate    DateTime?          @map("registration_last_date") @db.Date
  startDate               DateTime           @map("start_date") @db.Date
  endDate                 DateTime           @map("end_date") @db.Date
  turfCourtName           String?            @default("Ground 1 (Main Turf)") @map("turf_court_name") @db.VarChar(100)
  matchDurationMinutes    Int                @default(60) @map("match_duration_minutes")
  matchGapMinutes         Int                @default(15) @map("match_gap_minutes")

  // Section 3: Entry Fee & Prize Pool Distribution
  entryFeePerTeam         Decimal            @default(500.00) @map("entry_fee_per_team") @db.Decimal(10, 2)
  maximumTeams            Int                @default(16) @map("maximum_teams")
  minimumTeams            Int                @default(4) @map("minimum_teams")
  prizePoolTotal          String             @default("₹50,000") @map("prize_pool_total") @db.VarChar(150)
  firstPrizeWinner        Decimal            @default(30000.00) @map("first_prize_winner") @db.Decimal(10, 2)
  secondPrizeRunnerUp     Decimal            @default(15000.00) @map("second_prize_runner_up") @db.Decimal(10, 2)
  thirdPrize              Decimal            @default(5000.00) @map("third_prize") @db.Decimal(10, 2)

  // Section 4: Format & Player Criteria
  tournamentFormat        String             @default("Knockout Bracket") @map("tournament_format") @db.VarChar(50) // Knockout Bracket, League Table, Hybrid
  skillLevel              String             @default("Open to All") @map("skill_level") @db.VarChar(50)
  ageLimit                String             @default("Open (No limit)") @map("age_limit") @db.VarChar(50)
  genderCriteria          String             @default("All Genders") @map("gender_criteria") @db.VarChar(50)
  playersPerTeam          Int                @default(11) @map("players_per_team")
  substitutePlayers       Int                @default(5) @map("substitute_players")

  // Section 5: Visibility & Settings
  tournamentVisibility    String             @default("Public") @map("tournament_visibility") @db.VarChar(50)
  registrationApproval    String             @default("Auto Approval") @map("registration_approval") @db.VarChar(50)
  refundPolicy            String             @default("No Refund") @map("refund_policy") @db.VarChar(50)
  facilitiesAvailable     Json?              @map("facilities_available") // ["Parking", "Drinking Water", "Washroom", "Changing Room", "First Aid", "Flood Lights", "Live Score"]
  
  // Status & Weather
  status                  TournamentStatus   @default(UPCOMING) @map("status") // DRAFT, PENDING_REVIEW, REGISTRATION_OPEN, UPCOMING, ACTIVE, RUNNING, COMPLETED, CANCELLED
  weatherCheckSnapshot    Json?              @map("weather_check_snapshot") // { temp: "27°C", humidity: "45%", wind: "12 km/h", dew: "Low", lighting: "Optimal" }

  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @default(now()) @updatedAt @map("updated_at")

  // Relationships
  teams                   TournamentTeam[]
  fixtures                Fixture[]
  leaderboards            TournamentLeaderboard[]
  sponsors                TournamentSponsor[]
  payments                TournamentPayment[]

  @@index([branchId, status])
  @@map("tournaments")
}

model TournamentTeam {
  id              String               @id @map("id") @db.VarChar(50) // e.g. tm_101
  tournamentId    String               @map("tournament_id") @db.VarChar(50)
  tournament      Tournament           @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  teamName        String               @map("team_name") @db.VarChar(100)
  captainName     String               @map("captain_name") @db.VarChar(100)
  captainEmail    String               @map("captain_email") @db.VarChar(100)
  captainMobile   String               @map("captain_mobile") @db.VarChar(20)
  
  paymentMethod   PaymentMethod        @default(UPI) @map("payment_method")
  paymentStatus   PaymentStatus        @default(COMPLETED) @map("payment_status")
  status          TournamentTeamStatus @default(CONFIRMED) @map("status") // Approved, Pending, Rejected

  createdAt       DateTime             @default(now()) @map("created_at")

  // Relationships
  players         TournamentPlayer[]
  homeFixtures    Fixture[]            @relation("HomeTeam")
  awayFixtures    Fixture[]            @relation("AwayTeam")
  wonFixtures     Fixture[]            @relation("WinningTeam")
  leaderboardRows TournamentLeaderboard[]
  payments        TournamentPayment[]

  @@map("teams")
}

model TournamentPlayer {
  id           String         @id @default(cuid()) @map("id") @db.VarChar(50)
  teamId       String         @map("team_id") @db.VarChar(50)
  team         TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  playerName   String         @map("player_name") @db.VarChar(100)
  jerseyNumber Int?           @map("jersey_number")
  role         String?        @map("role") @db.VarChar(50) // Batsman, Bowler, All-Rounder, Keeper, Striker, Defender
  mobile       String?        @map("mobile") @db.VarChar(20)
  idProofUrl   String?        @map("id_proof_url") @db.VarChar(255)

  createdAt    DateTime       @default(now()) @map("created_at")

  @@map("team_players")
}

model Fixture {
  id               String         @id @map("id") @db.VarChar(50) // e.g. fix_101
  tournamentId     String         @map("tournament_id") @db.VarChar(50)
  tournament       Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  roundName        String         @map("round_name") @db.VarChar(50) // Quarter-Finals, Semi-Finals, Grand Finale
  matchNumber      Int            @map("match_number")
  teamAId          String         @map("team_a_id") @db.VarChar(50)
  teamA            TournamentTeam @relation("HomeTeam", fields: [teamAId], references: [id], onDelete: Cascade)
  teamBId          String         @map("team_b_id") @db.VarChar(50)
  teamB            TournamentTeam @relation("AwayTeam", fields: [teamBId], references: [id], onDelete: Cascade)

  // Scores & Inning details (e.g. 142/4 16.2 ov vs 138/8 20 ov or 2 vs 1)
  teamAScore       String?        @map("team_a_score") @db.VarChar(50)
  teamBScore       String?        @map("team_b_score") @db.VarChar(50)
  teamAOvers       String?        @map("team_a_overs") @db.VarChar(20)
  teamBOvers       String?        @map("team_b_overs") @db.VarChar(20)
  matchSummary     String?        @map("match_summary") @db.VarChar(150) // e.g. "In Progress (2nd Innings)"
  groundCourtName  String?        @default("Ground 1 - Main Turf") @map("ground_court_name") @db.VarChar(100)

  // Disciplinary Yellow & Red Cards
  yellowCardsTeamA Int            @default(0) @map("yellow_cards_team_a")
  redCardsTeamA    Int            @default(0) @map("red_cards_team_a")
  yellowCardsTeamB Int            @default(0) @map("yellow_cards_team_b")
  redCardsTeamB    Int            @default(0) @map("red_cards_team_b")

  winnerId         String?        @map("winner_id") @db.VarChar(50)
  winner           TournamentTeam? @relation("WinningTeam", fields: [winnerId], references: [id], onDelete: SetNull)

  verificationTier LeaderboardTier @default(OFFICIAL_TOURNAMENT) @map("verification_tier") // 2.0x weight
  matchDate        DateTime       @map("match_date") @db.Date
  matchTime        String         @map("match_time") @db.VarChar(20)
  status           FixtureStatus  @default(SCHEDULED) @map("status") // SCHEDULED, LIVE, COMPLETED, ABANDONED

  createdAt        DateTime       @default(now()) @map("created_at")

  @@map("fixtures")
}

model TournamentLeaderboard {
  id             String         @id @default(cuid()) @map("id") @db.VarChar(50)
  tournamentId   String         @map("tournament_id") @db.VarChar(50)
  tournament     Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId         String         @map("team_id") @db.VarChar(50)
  team           TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  matchesPlayed  Int            @default(0) @map("matches_played")
  matchesWon     Int            @default(0) @map("matches_won")
  matchesLost    Int            @default(0) @map("matches_lost")
  matchesTied    Int            @default(0) @map("matches_tied")
  points         Int            @default(0) @map("points")
  netRunRate     Decimal?       @default(0.00) @map("net_run_rate") @db.Decimal(5, 3)

  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at")

  @@unique([tournamentId, teamId])
  @@map("leaderboards")
}

model TournamentSponsor {
  id            String     @id @default(cuid()) @map("id") @db.VarChar(50)
  tournamentId  String     @map("tournament_id") @db.VarChar(50)
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  sponsorName   String     @map("sponsor_name") @db.VarChar(100) // RedBull Energy, Nike Sports India
  logo          String?    @map("logo") @db.VarChar(255)
  sponsorTier   String     @default("Gold Sponsor") @map("sponsor_tier") @db.VarChar(50) // Platinum Sponsor, Gold Sponsor, Silver Sponsor, Bronze Sponsor
  packageAmount Decimal    @map("package_amount") @db.Decimal(10, 2) // ₹50,000, ₹30,000, ₹15,000, ₹5,000
  websiteUrl    String?    @map("website_url") @db.VarChar(255)
  status        String     @default("ACTIVE") @map("status") @db.VarChar(20)

  createdAt     DateTime   @default(now()) @map("created_at")

  @@map("tournament_sponsors")
}

model TournamentPayment {
  id               String         @id @default(cuid()) @map("id") @db.VarChar(50)
  invoiceNumber    String         @unique @map("invoice_number") @db.VarChar(50) // e.g. INV-TRN-1001, INV-SPN-2001
  tournamentId     String         @map("tournament_id") @db.VarChar(50)
  tournament       Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId           String?        @map("team_id") @db.VarChar(50)
  team             TournamentTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  payerName        String         @map("payer_name") @db.VarChar(100) // Indore Thunders, RedBull Energy
  transactionType  String         @default("Entry Fee") @map("transaction_type") @db.VarChar(50) // Entry Fee, Sponsor Payment, Prize Payout
  amount           Decimal        @map("amount") @db.Decimal(10, 2)
  platformCommRate Decimal        @default(10.00) @map("platform_comm_rate") @db.Decimal(5, 2) // 10%
  commissionAmount Decimal        @default(0.00) @map("commission_amount") @db.Decimal(10, 2)
  paymentMode      PaymentMethod  @default(UPI) @map("payment_mode")
  status           PaymentStatus  @default(COMPLETED) @map("status")
  transactionId    String?        @map("transaction_id") @db.VarChar(100)

  createdAt        DateTime       @default(now()) @map("created_at")

  @@map("tournament_payments")
}

model TournamentSetting {
  id                             String   @id @default("global_tournament_settings") @map("id") @db.VarChar(50)
  platformCommissionPercentage   Decimal  @default(10.00) @map("platform_commission_percentage") @db.Decimal(5, 2)
  automaticSlotReservation       Boolean  @default(true) @map("automatic_slot_reservation")
  allowStaffTournamentCreation   Boolean  @default(true) @map("allow_staff_tournament_creation")
  automatedApprovalNotifications Boolean  @default(true) @map("automated_approval_notifications")
  updatedAt                      DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("tournament_settings")
}

